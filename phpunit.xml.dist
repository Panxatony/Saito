<?xml version="1.0" encoding="UTF-8"?>
<!-- `failOnWarning` + `displayDetailsOnTestsThatTriggerWarnings`, since 8.4.20.
     PHPUnit 13.3 began counting a PHP warning raised in our own code and the
     run still exited 0: "OK, but there were issues! … Warnings: 1", with the
     warning itself not printed. It was a real flaw on the passkey login path.
     A count nobody can read, on a run that stays green, is a signal that gets
     ignored — so a warning from src/ or plugins/*/src/ now fails the suite
     and says where it came from. Dependencies are still excluded by the
     `restrictWarnings` below, so this is a gate that can actually be passed. -->
<phpunit colors="true" processIsolation="false" stopOnFailure="false" bootstrap="./tests/bootstrap.php"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
  <php>
    <ini name="memory_limit" value="-1"/>
  </php>
  <!-- Add any additional test suites you want to run here -->
  <testsuites>
    <testsuite name="App Test Suite">
      <directory>./tests/TestCase</directory>
    </testsuite>
    <testsuite name="Plugins Test Suites">
      <directory>./plugins/*/tests/TestCase</directory>
    </testsuite>
  </testsuites>
  <!-- Which code is *ours*. Two jobs: it scopes coverage, and it decides which
       diagnostics the run is allowed to fail on.

       `restrictNotices`/`restrictWarnings` and `ignoreIndirectDeprecations`
       together say: a notice, warning or deprecation raised inside a dependency
       is not this suite's business. Without them the run exits non-zero over 568
       notices from CakePHP's Debugger, jbbcode and suin/php-rss-writer — none of
       which any change here can fix, and a gate nobody can pass stops being read.
       Anything triggered in src/ or plugins/*/src/ still fails the run. -->
  <source restrictNotices="true"
          restrictWarnings="true"
          ignoreIndirectDeprecations="true">
    <include>
      <directory suffix=".php">./src/</directory>
      <directory suffix=".php">./plugins/*/src/</directory>
    </include>
  </source>
</phpunit>
