{
  "compilerOptions": {
    "target": "es2017",
    // Without an explicit `lib` this follows `target`, which left the standard
    // library at ES2015 — so `Array.prototype.includes` (ES2016) type-checked
    // as an error in island code that has always shipped and always worked.
    // The build never noticed: esbuild strips types without checking them.
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "allowSyntheticDefaultImports": true,
    "strict": true,
  },
  "include": [
    "frontend/src/**/*",
  ],
}
