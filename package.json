{
  "name": "Saito",
  "private": true,
  "dependencies": {
    "@fontsource/cabin": "^5.3.0",
    "@fontsource/fenix": "^5.3.0",
    "alpinejs": "^3.16.1",
    "bootstrap": "5.3.8",
    "font-awesome": "^4.7.0",
    "htmx.org": "^2.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10",
    "cssnano": "^8",
    "eslint": "^10",
    "fast-glob": "^3",
    "globals": "^17.11.0",
    "postcss": "^8",
    "purgecss": "8",
    "sass": "^1",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=22.11",
    "yarn": ">= 1.0.0"
  },
  "scripts": {
    "lint": "tsc --noEmit && eslint \"frontend/src/**/*.ts\"",
    "build": "ENTRY=htmx-threads vite build && ENTRY=admin vite build && ENTRY=boot vite build",
    "dev": "ENTRY=htmx-threads vite build --watch",
    "typecheck": "tsc --noEmit",
    "css:static": "sass --no-source-map --style=expanded --load-path=node_modules --quiet-deps --fatal-deprecation=slash-div --fatal-deprecation=global-builtin --fatal-deprecation=color-functions webroot/css/src/static.scss:webroot/css/stylesheets/static.css",
    "css:theme": "sass --no-source-map --style=expanded --load-path=node_modules --quiet-deps --fatal-deprecation=slash-div --fatal-deprecation=global-builtin --fatal-deprecation=color-functions plugins/Bota/webroot/css/src/theme.scss:plugins/Bota/webroot/css/theme.css plugins/Bota/webroot/css/src/night.scss:plugins/Bota/webroot/css/night.css plugins/Nova/webroot/css/src/theme.scss:plugins/Nova/webroot/css/theme.css plugins/Nova/webroot/css/src/night.scss:plugins/Nova/webroot/css/night.css plugins/Macnemo/webroot/css/src/theme.scss:plugins/Macnemo/webroot/css/theme.css plugins/Macnemo/webroot/css/src/night.scss:plugins/Macnemo/webroot/css/night.css",
    "css": "yarn css:static && yarn css:theme",
    "css:purge": "node dev/purge-css.js",
    "css:postcss": "node dev/postcss-release.js",
    "clean:js": "node dev/clean-js.js",
    "assets:copy": "node dev/copy-assets.js",
    "build:release": "yarn clean:js && yarn css && yarn css:postcss && yarn css:purge && yarn build && yarn assets:copy",
    "setup": "yarn install && yarn assets:copy"
  },
  "browserslist": [
    "last 2 versions",
    "not dead"
  ]
}
